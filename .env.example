# ==============================================================================
# Sports Portal — Production Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env or configure directly in your Vercel Project Settings.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# For Vercel deployment, use a cloud PostgreSQL database:
# - Neon: https://neon.tech (Recommended: serverless Postgres with pooling)
# - Supabase: https://supabase.com
# - Vercel Postgres: https://vercel.com/storage/postgres
# - Railway / Render: https://railway.app
#
# Standard Connection String:
DATABASE_URL="postgresql://username:password@ep-cool-host.region.aws.neon.tech/neondb?sslmode=require"

# (Optional: Direct Connection URL if using Supabase connection pooler / PgBouncer on port 6543)
# DIRECT_URL="postgresql://username:password@db.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH.JS AUTHENTICATION
# ------------------------------------------------------------------------------
# In production on Vercel, set NEXTAUTH_URL to your production domain or Vercel URL
# (e.g., https://your-sports-portal.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Generate a strong 32-byte secret using: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-strong-32-byte-secret-for-production"

# ------------------------------------------------------------------------------
# 3. CRON JOB & NEWS SYNC SECURITY
# ------------------------------------------------------------------------------
# Secret token used by Vercel Cron jobs or external schedulers to trigger /api/news/sync
# Pass as ?token=YOUR_SECRET or Authorization: Bearer YOUR_SECRET
CRON_SECRET="sports_portal_sync_token_2026"

# ------------------------------------------------------------------------------
# 4. MULTI-PROVIDER ARCHITECTURE (FOOTBALL)
# ------------------------------------------------------------------------------
# Tier 1 Primary Football Provider (Bzzoiro Sports Data API v2)
BZZOIRO_API_KEY="fccc7814bede204c09b2dc587206059be059597e"

# Specialist Football Predictions & Season Analytics (Football-Charts.com)
FOOTBALL_CHARTS_API_KEY="fc_NJ4AHohUbGRuMgbwv_3zEnIzNcQxvCNS"

# Tier 2 Secondary Football Provider & Standings (football-data.org)
FOOTBALL_DATA_TOKEN="29cd232822934065962a8d76e547b83b"

# Tier 3 Tertiary Failover Provider (footballdata.io)
FOOTBALLDATA_IO_KEY="fd_7493197ff678d02f64444362755bc87937363384ee3f6e30"

# Legacy / Standings Provider (API-Football / v3.football.api-sports.io)
FOOTBALL_API_KEY="b9c83628c8449f161672f3b4c7319580"

# Specialist Media & Club Crests (TheSportsDB - "3" is public test key)
THESPORTSDB_KEY="3"

# ------------------------------------------------------------------------------
# 5. MULTI-SPORT NBA PROVIDER
# ------------------------------------------------------------------------------
# Balldontlie.io API key for live NBA matchups, standings, and player leaders
BALLDONTLIE_API_KEY=""

# ------------------------------------------------------------------------------
# 6. OPTIONAL: REALTIME WEBSOCKET (FUTURE UPGRADE)
# ------------------------------------------------------------------------------
# Optional WebSocket endpoint for Bzzoiro Live Tier
NEXT_PUBLIC_BZZOIRO_WS_URL=""

# ------------------------------------------------------------------------------
# 7. OPTIONAL: SOCIAL OAUTH PROVIDERS
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
