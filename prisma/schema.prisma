// ==========================================================
// Sports Portal — Prisma Schema
// Database: PostgreSQL (Production & Cloud Database)
// Models: User, Account, Session, Article, Team, Player,
//         Match, Comment, FavoriteTeam, SiteSettings
// ==========================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models (NextAuth Adapter) ────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for credentials login
  role          String    @default("USER") // "USER" | "ADMIN"

  accounts      Account[]
  sessions      Session[]
  articles      Article[]       @relation("AuthorArticles")
  comments      Comment[]
  favoriteTeams FavoriteTeam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Content Models ────────────────────────────────────────

model Article {
  id         String  @id @default(cuid())
  title      String
  titleFa    String?
  slug       String  @unique
  excerpt    String
  excerptFa  String?
  content    String
  contentFa  String?
  coverImage String
  category   String  @default("GENERAL") // FOOTBALL | BASKETBALL | TENNIS | CRICKET | GENERAL
  published  Boolean @default(false)
  source     String? // e.g. "BBC Sport", "ESPN", "Goal.com", "Sky Sports"
  sourceUrl  String? // Original RSS article URL

  authorId String
  author   User   @relation("AuthorArticles", fields: [authorId], references: [id], onDelete: Cascade)

  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}

model Comment {
  id      String @id @default(cuid())
  content String

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("comments")
}

// ─── Sports Models ─────────────────────────────────────────

model Team {
  id        String  @id @default(cuid())
  name      String
  nameFa    String?
  shortName String
  logo      String
  league    String
  leagueFa  String?
  country   String
  founded   Int?
  stadium   String?
  stadiumFa String?

  homeMatches   Match[]        @relation("HomeTeam")
  awayMatches   Match[]        @relation("AwayTeam")
  players       Player[]
  favoriteTeams FavoriteTeam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teams")
}

model Player {
  id            String  @id @default(cuid())
  name          String
  nameFa        String?
  position      String
  positionFa    String?
  number        Int?
  nationality   String
  nationalityFa String?
  image         String

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  goals       Int @default(0)
  assists     Int @default(0)
  appearances Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("players")
}

model Match {
  id        String   @id @default(cuid())
  homeScore Int?
  awayScore Int?
  status    String   @default("NOT_STARTED") // NOT_STARTED | FIRST_HALF | HALF_TIME | SECOND_HALF | FINISHED | POSTPONED | CANCELLED
  matchDate DateTime
  venue     String?
  league    String
  minute    Int?

  homeTeamId String
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("matches")
}

// ─── User Preferences ─────────────────────────────────────

model FavoriteTeam {
  id     String @id @default(cuid())
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@map("favorite_teams")
}

// ─── Site Configuration ───────────────────────────────────

model SiteSettings {
  id                  String  @id @default("default")
  siteName            String  @default("Sports Portal")
  siteDescription     String  @default("Your one-stop destination for all sports content")
  maintenanceMode     Boolean @default(false)
  featuredArticleIds  String  @default("[]") // JSON string array

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
